{
    "name": "Admin Cash Register Entry",
    "module": "Custom Erp",
    "doctype": "DocType",
    "engine": "InnoDB",
    "autoname": "format:ACRE-{YYYY}-{MM}-{####}",
    "naming_rule": "Expression",
    "track_changes": 1,
    "sort_field": "entry_datetime",
    "sort_order": "DESC",
    "fields": [
        {
            "fieldname": "entry_datetime",
            "fieldtype": "Datetime",
            "label": "Date & Time",
            "reqd": 1,
            "default": "Now",
            "in_list_view": 1
        },
        {
            "fieldname": "entry_type",
            "fieldtype": "Select",
            "label": "Entry Type",
            "options": "In\nOut",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "topic",
            "fieldtype": "Select",
            "label": "Topic",
            "options": "Counter Sales\nEmployee Deposit\nAdvance Recovery\nUtility Expense\nEmployee Advance\nPurchase Expense\nOther",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "payment_mode",
            "fieldtype": "Select",
            "label": "Payment Mode",
            "options": "Cash\nQR\nBank Transfer\nCheque",
            "reqd": 1
        },
        {
            "fieldname": "amount",
            "fieldtype": "Currency",
            "label": "Amount",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "employee_ref",
            "fieldtype": "Link",
            "label": "Employee (if applicable)",
            "options": "Employee"
        },
        {
            "fieldname": "customer_ref",
            "fieldtype": "Link",
            "label": "Customer (if applicable)",
            "options": "Customer"
        },
        {
            "fieldname": "advance_ref",
            "fieldtype": "Link",
            "label": "Advance Reference",
            "options": "Employee Advance CC",
            "depends_on": "eval:doc.topic == 'Employee Advance' || doc.topic == 'Advance Recovery'"
        },
        {
            "fieldname": "remarks",
            "fieldtype": "Small Text",
            "label": "Remarks"
        },
        {
            "fieldname": "entered_by",
            "fieldtype": "Link",
            "label": "Entered By",
            "options": "User",
            "default": "__user",
            "read_only": 1
        }
    ],
    "permissions": [
        {
            "role": "CC Admin",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1
        },
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1
        }
    ]
}
