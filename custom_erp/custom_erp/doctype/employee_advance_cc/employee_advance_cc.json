{
    "name": "Employee Advance CC",
    "module": "Custom Erp",
    "doctype": "DocType",
    "engine": "InnoDB",
    "autoname": "format:ADV-{YYYY}-{MM}-{####}",
    "naming_rule": "Expression",
    "track_changes": 1,
    "sort_field": "advance_date",
    "sort_order": "DESC",
    "fields": [
        {
            "fieldname": "employee",
            "fieldtype": "Link",
            "label": "Employee",
            "options": "Employee",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "employee_name",
            "fieldtype": "Data",
            "label": "Employee Name",
            "fetch_from": "employee.employee_name",
            "read_only": 1
        },
        {
            "fieldname": "advance_date",
            "fieldtype": "Date",
            "label": "Date Given",
            "reqd": 1,
            "default": "Today",
            "in_list_view": 1
        },
        {
            "fieldname": "amount_given",
            "fieldtype": "Currency",
            "label": "Amount Given",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "repaid_amount",
            "fieldtype": "Currency",
            "label": "Repaid Amount",
            "default": "0",
            "read_only": 1
        },
        {
            "fieldname": "balance",
            "fieldtype": "Currency",
            "label": "Outstanding Balance",
            "read_only": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Outstanding\nPartially Repaid\nCleared",
            "default": "Outstanding",
            "in_list_view": 1
        },
        {
            "fieldname": "given_by",
            "fieldtype": "Link",
            "label": "Given By",
            "options": "User",
            "default": "__user",
            "read_only": 1
        },
        {
            "fieldname": "remarks",
            "fieldtype": "Small Text",
            "label": "Remarks"
        }
    ],
    "permissions": [
        {
            "role": "CC Admin",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1
        },
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1
        }
    ]
}
